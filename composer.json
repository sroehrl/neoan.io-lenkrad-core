{
  "name": "neoan.io/core",
  "description": "Neoan.io Lenkrad Framework",
  "type": "package",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Stefan Roehrl",
      "email": "neoan@neoan.us"
    }
  ],
  "require": {
    "php": "~8.2",
    "neoan3-apps/template": "^2",
    "vlucas/phpdotenv": "^5",
    "symfony/console": "^7.4",
    "ext-pdo": "*",
    "ext-openssl": "*",
    "composer/composer": "^2",
    "ramsey/uuid": "^4",
    "monolog/monolog": "^3"
  },
  "autoload": {
    "psr-4": {
      "Neoan\\": "src/"
    }

  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/",
      "Playground\\": "_playground/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "9.5",
    "ext-simplexml": "*"
  },
  "scripts": {
    "test": ["phpunit --configuration phpunit.xml --teamcity","php -f tests/get-coverage.php -- 80 verbose"],
    "current-coverage": "php -f tests/get-coverage.php -- 80"
  }
}
